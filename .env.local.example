# GitHub personal access token (optional, but recommended).
# Without it you get 60 requests/hour; with it, 5,000.
# Create one at https://github.com/settings/tokens — no scopes are needed
# for reading issues from public repositories.
GITHUB_TOKEN=your_github_token_here

# Public URL of the deployment. Only needed to override the canonical domain
# (https://ycfirstpr.vercel.app), e.g. when moving to a custom domain.
# NEXT_PUBLIC_SITE_URL=https://ycfirstpr.vercel.app
